{
  "manifest_version": 3,
  "name": "NovaFolio - Crypto Portfolio Simulator",
  "version": "2.0.0",
  "description": "A customizable cryptocurrency portfolio tracker, analytics, staking and alert simulator with live market prices for Firefox.",
  "action": {
    "default_title": "NovaFolio Simulator",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "96": "icon.png"
    }
  },
  "sidebar_action": {
    "default_title": "NovaFolio Simulator",
    "default_panel": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://api.coingecko.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "novafolio-simulator@portfolio.dev",
      "strict_min_version": "109.0"
    }
  }
}
